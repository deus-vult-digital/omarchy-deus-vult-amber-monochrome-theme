# Deus Vult Amber Monochrome: btop on a P3 phosphor CRT. Boxes and graphs run the
# amber ramp; temperature and the "available" meter climb into amber and red.
# Generated by tools/build.py from phosphors.toml.

theme[main_bg]="#0b0803"
theme[main_fg]="#fcd34d"
theme[title]="#fbbf24"
theme[hi_fg]="#f59e0b"
theme[selected_bg]="#78350f"
theme[selected_fg]="#fef3c7"
theme[inactive_fg]="#746144"
theme[graph_text]="#fde68a"
theme[meter_bg]="#1a1208"
theme[proc_misc]="#fbbf24"

theme[cpu_box]="#92400e"
theme[mem_box]="#92400e"
theme[net_box]="#92400e"
